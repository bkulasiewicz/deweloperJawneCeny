# Force no-cache for external-cron endpoint
<IfModule mod_rewrite.c>
RewriteEngine On

# Specific rule for ujc external-cron endpoint
RewriteCond %{REQUEST_URI} ^/wp-json/ujc/v1/external-cron$
RewriteRule . - [E=no-cache:1,L]

# Set no-cache headers for external-cron
<IfModule mod_headers.c>
Header always set Cache-Control "no-cache, no-store, must-revalidate" env=no-cache
Header always set Pragma "no-cache" env=no-cache
Header always set Expires "0" env=no-cache
</IfModule>
</IfModule>

# Additional LiteSpeed specific directives
<IfModule Litespeed>
RewriteCond %{REQUEST_URI} ^/wp-json/ujc/v1/external-cron$
RewriteRule . - [E=Cache-Control:no-cache]
</IfModule>